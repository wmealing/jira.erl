{deps, [
    {want, {git, "https://github.com/wrren/want.erl.git", {branch, "master"}}},
    {url, {git, "https://github.com/wrren/url.erl.git", {branch, "master"}}},
    {hackney, "1.25.0"},
    {jsx, {git, "https://github.com/talentdeficit/jsx.git", {branch, "main"}}}
]}.


{ct_opts, [{config, "config/test.config"}]}.

{eunit_tests, [{inparallel, jira_tests}]}.

{eunit_opts, [verbose]}.

{project_plugins, [erlfmt]}.

{erlfmt, [write]}.
